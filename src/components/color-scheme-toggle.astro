<button
  aria-label="Light mode"
  aria-pressed="false"
  class="theme-toggle"
  hidden
  id="theme-toggle"
  title="Light mode"
  type="button"
>
  <svg aria-hidden="true" viewBox="0 0 24 24">
    <!-- Pixelarticons by Gerrit Halfmann (MIT), from the original light-mode branch. -->
    <path
      class="bulb-outline"
      d="M8 2h8v2H8zM6 6V4h2v2zm0 6H4V6h2zm2 2H6v-2h2zm8 0v4H8v-4h2v2h4v-2zm2-2v2h-2v-2zm0-6h2v6h-2zm0 0V4h-2v2zm-2 14H8v2h8z"
      fill="currentColor"></path>
    <path
      class="bulb-fill"
      d="M8 4h8v2h2v6h-2v2h-2v2h-4v-2H8v-2H6V6h2z"
      fill="currentColor"></path>
  </svg>
</button>

<script>
  function initializeToggle() {
    const button = document.querySelector<HTMLButtonElement>("#theme-toggle");
    if (!button) return;
    const root = document.documentElement;
    const system = globalThis.matchMedia("(prefers-color-scheme: dark)");
    let preference: string | undefined;
    try {
      const saved = localStorage.getItem("theme");
      if (saved === "light" || saved === "dark") preference = saved;
    } catch {
      // Storage may be unavailable; the toggle still works in memory.
    }

    const apply = () => {
      const theme = preference ?? (system.matches ? "dark" : "light");
      root.dataset.theme = theme;
      button.setAttribute("aria-pressed", String(theme === "light"));
      button.title =
        theme === "light" ? "Switch to dark mode" : "Switch to light mode";
    };
    button.addEventListener("click", () => {
      preference = root.dataset.theme === "light" ? "dark" : "light";
      try {
        localStorage.setItem("theme", preference);
      } catch {
        // In-memory fallback.
      }
      apply();
    });
    system.addEventListener("change", apply);
    globalThis.addEventListener("storage", (event) => {
      if (event.key !== "theme" && event.key !== null) return;
      preference =
        event.newValue === "light" || event.newValue === "dark"
          ? event.newValue
          : undefined;
      apply();
    });
    apply();
    button.hidden = false;
  }
  initializeToggle();
</script>

<style>
  .theme-toggle {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin: 1.25rem auto 0;
    cursor: pointer;
    color: var(--color-yellow-200);
  }
  .theme-toggle::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -12px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      oklch(97.3% 0.071 103.193 / 0.8),
      oklch(97.3% 0.071 103.193 / 0) 70%
    );
    opacity: 0;
    pointer-events: none;
  }
  svg {
    width: 36px;
    height: 36px;
  }
  .bulb-fill {
    opacity: 0;
  }
  [aria-pressed="true"] {
    color: oklch(40% 0.1 80);
  }
  [aria-pressed="true"]::before,
  .theme-toggle:hover::before {
    opacity: 1;
  }
  [aria-pressed="true"] .bulb-fill {
    color: oklch(97.3% 0.071 103.193);
    opacity: 1;
  }
  .theme-toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
</style>
