---
import LightbulbOffIcon from "../assets/images/lightbulb-off.svg";
import LightbulbIcon from "../assets/images/lightbulb.svg";

// TODO What are the aria props?
// How does localStorage.theme work? diff from getItem?
---

<script>
  const colorSchemeToggle = document.querySelector(
    "#NBASTT-Color-Scheme-Toggle",
  ) as HTMLButtonElement;

  colorSchemeToggle.addEventListener("click", () => {
    const currentTheme =
      localStorage.theme ||
      (globalThis.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light");
    localStorage.theme = currentTheme === "dark" ? "light" : "dark";
    document.documentElement.classList.toggle(
      "dark",
      localStorage.theme === "dark",
    );
  });
</script>

<button
  aria-label="auto"
  aria-live="polite"
  class="w-8 rounded-full text-stone-100 lg:w-14 dark:text-yellow-200 dark:opacity-70"
  id="NBASTT-Color-Scheme-Toggle"
  title="Toggles light & dark"
>
  <LightbulbIcon
    class="hover:fill-dark-emerald shadow-lightbulb block rounded-full bg-radial from-yellow-200/50 from-20% to-yellow-100/50 hover:opacity-50 dark:hidden"
    fill="currentColor"
    role="img"
  />
  <LightbulbOffIcon
    class="hover:shadow-lightbulb hidden rounded-full from-yellow-200/50 from-50% to-yellow-100/15 hover:bg-radial dark:block"
    fill="currentColor"
    role="img"
  />
</button>
