---
interface Props {
  class?: string;
}

const { class: classStr, ...attrs } = Astro.props;
---

<div class:list={["crash-container", classStr]} {...attrs}>
  <p class="crash-title">Oof!</p>
  <p class="crash-subtitle">Something blew up</p>
  <p class="crash-message">
    Sorry for the incovenience! Check back later; we'll have this fixed.
  </p>
</div>

<style>
  .crash-container {
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem;
  }

  @media (min-width: 768px) {
    .crash-container {
      max-width: 60%;
    }
  }

  .crash-title {
    font-family: var(--font-title);
    text-align: center;
    font-size: var(--text-4xl);
    line-height: var(--text-4xl--line-height);
    color: var(--color-yellow-400);
    text-transform: uppercase;
    font-style: italic;
  }

  @media (min-width: 768px) {
    .crash-title {
      font-size: var(--text-6xl);
      line-height: var(--text-6xl--line-height);
    }
  }

  .crash-subtitle {
    font-family: var(--font-title);
    margin-bottom: 1rem;
    text-align: center;
    font-size: var(--text-2xl);
    line-height: var(--text-2xl--line-height);
    color: var(--color-yellow-400);
  }

  @media (min-width: 768px) {
    .crash-subtitle {
      font-size: var(--text-4xl);
      line-height: var(--text-4xl--line-height);
    }
  }

  .crash-message {
    text-align: center;
    font-size: var(--text-2xl);
    line-height: var(--text-2xl--line-height);
    color: var(--color-yellow-200);
  }

  @media (min-width: 1024px) {
    .crash-message {
      max-width: 60%;
    }
  }
</style>
