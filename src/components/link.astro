---
import type { HTMLAttributes } from "astro/types";
type Props = HTMLAttributes<"a">;
const { class: classStr, href, ...attrs } = Astro.props;
---

<style>
  .NBASTT-Link {
    color: var(--ink-link);
    text-decoration: underline;

    &:hover {
      color: var(--ink-link-hover);
    }

    &.active {
      pointer-events: none;
      cursor: default;
      color: var(--ink-link-active);
    }
  }

  :global(:root[data-theme="light"]) .NBASTT-Link {
    &:active {
      color: var(--ink-link-active);
    }
  }
</style>

<a class:list={["NBASTT-Link", classStr]} href={href} {...attrs}><slot /></a>
