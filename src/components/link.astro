---
import type { HTMLAttributes } from "astro/types";
type Props = HTMLAttributes<"a">;
const { class: classStr, href, ...attrs } = Astro.props;
---

<style>
  .NBASTT-Link {
    color: var(--color-indigo-400);
    text-decoration: underline;

    &:hover {
      color: var(--color-indigo-100);
    }

    &.active {
      pointer-events: none;
      cursor: default;
      color: var(--color-indigo-100);
    }
  }
</style>

<a class:list={["NBASTT-Link", classStr]} href={href} {...attrs}><slot /></a>
