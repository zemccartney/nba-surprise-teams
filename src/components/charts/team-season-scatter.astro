---
/*
  Chart host + data; the script mounts TanStack Charts on the client. Data travels as a
  JSON script block rather than an attribute so it isn't HTML-escaped.
*/
import type { TeamSeasonScatterplotProps } from "./team-season-scatter";

import "./charts.css";

type Props = TeamSeasonScatterplotProps;

const json = JSON.stringify(Astro.props).replaceAll("<", String.raw`\u003c`);
---

<div class="chart" data-chart="team-season-scatter">
  <script is:inline set:html={json} type="application/json" />
</div>

<script>
  import { mountCharts } from "./tanstack";
  import { scatterChart } from "./tanstack-options";

  mountCharts("team-season-scatter", scatterChart);
</script>
