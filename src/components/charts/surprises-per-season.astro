---
/*
  Chart host + data; the script mounts ECharts on the client. Data travels as a
  JSON script block rather than an attribute so it isn't HTML-escaped.
*/
import type { SurprisesPerSeasonChartProps } from "./surprises-per-season";

import "./charts.css";

type Props = SurprisesPerSeasonChartProps;

const json = JSON.stringify(Astro.props).replaceAll("<", String.raw`\u003c`);
---

<div class="chart" data-chart="surprises-per-season">
  <script is:inline set:html={json} type="application/json" />
</div>

<script>
  import { mountCharts } from "./echarts";
  import { option } from "./surprises-per-season";

  mountCharts("surprises-per-season", option);
</script>
