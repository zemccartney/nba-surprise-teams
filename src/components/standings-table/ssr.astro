---
import { actions } from "astro:actions";

import type { Season } from "../../data/model";

import { liveCacheControl } from "../../loaders/live/utils";
import Crash from "../crash.astro";
import UI from "./ui.astro";

interface Props {
  seasonId: Season["id"];
}

const { seasonId } = Astro.props;

const { data, error } = await Astro.callAction(actions.getSeasonData, {
  seasonId,
});

if (!error) {
  const cacheControl = liveCacheControl(data.expiresAt);

  if (cacheControl) {
    Astro.response.headers.set("Cache-Control", cacheControl);
  }
}
---

{error ? <Crash /> : <UI games={data.games} seasonId={seasonId} />}
