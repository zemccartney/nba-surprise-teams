---
import type { CollectionEntry } from "astro:content";

import { getEntry } from "astro:content";

import type { GameData } from "../../content-utils";

import * as ContentUtils from "../../content-utils";
import * as Utils from "../../utils";
import Link from "../link.astro";
import Logo from "../logo.astro";
import Popover from "../popover.astro";
import ResultEmoji from "../result-emoji.astro";
import Table from "../table.astro";

interface Props {
  games: GameData[];
  seasonId: CollectionEntry<"seasons">["id"];
  title?: string;
}

const { games, seasonId, title } = Astro.props;

const teamsInSeason = await ContentUtils.getTeamsInSeason(seasonId);

const teamRows = [];

for (const team of teamsInSeason) {
  const record = ContentUtils.calculateTeamRecord(team.id, games);
  // eslint-disable-next-line @typescript-eslint/no-non-null-assertion
  const teamSeason = await getEntry("teamSeasons", `${seasonId}/${team.id}`)!;

  teamRows.push({
    isEliminated: await ContentUtils.isEliminated(teamSeason, record),
    isSurpriseTeam: await ContentUtils.isSurprise(teamSeason, record),
    pace: await ContentUtils.pace(teamSeason, record),
    record,
    team,
    teamSeason,
  });
}

// if pre-season i.e. where all project records will be 0-82,
// this sort order is the same as over/under ascending: the lower
// a team's over/under, the fewer games they need to win to be a
// surprise team, the smaller the discrepancy between that target
// and their current 0 wins. Felt like a sensible enough default,
// if not immediately apparent
teamRows.sort((a, b) => b.pace - a.pace);

const surpriseRules = await ContentUtils.getSeasonSurpriseRules(seasonId);
---

<script>
  const mediaQueryList = globalThis.matchMedia(
    "not all and (min-width: 640px)",
  );

  function handleOrientationChange(ev: MediaQueryList | MediaQueryListEvent) {
    const table = document.querySelector("#standings");
    if (table) {
      table.classList.toggle("compact", ev.matches);
    }
  }

  handleOrientationChange(mediaQueryList);
  mediaQueryList.addEventListener("change", handleOrientationChange);
</script>

<Table class="stickyHeader standings-table" id="standings">
  <Fragment slot="head">
    <tr>
      <td class="title-cell">{title}</td>
      <th class="ou-col" scope="col">
        <span class="mobile-only">O/U</span>
        <span class="desktop-only">Over/Under</span>
      </th>
      <th class="pace-col" scope="col">
        Pace
        <Popover id="pace-popover">
          <p class="popover-heading">Pace</p>
          <p>
            Current Projected Wins - Wins needed to surprise ({
              surpriseRules.paceTarget
            } wins above a team's preseason over/under (rounded up))
          </p>
        </Popover>
      </th>
    </tr>
  </Fragment>
  <Fragment slot="body">
    {
      teamRows.map((teamRow) => {
        return (
          <tr>
            <th scope="row">
              <div class="team-cell">
                <Logo seasonId={seasonId} team={teamRow.team} />
                <Link href={`/${seasonId}/${teamRow.team.id}`}>
                  <span class="team-name-full">
                    {ContentUtils.resolveTeamName(teamRow.team, seasonId)}
                    <span
                      class:list={[
                        "status-icon",
                        {
                          "has-icon":
                            teamRow.isSurpriseTeam || teamRow.isEliminated,
                        },
                      ]}
                    >
                      {teamRow.isSurpriseTeam && (
                        <ResultEmoji name="surprise" width={20} />
                      )}
                      {teamRow.isEliminated && (
                        <ResultEmoji name="eliminated" width={20} />
                      )}
                    </span>
                  </span>

                  <span class="team-name-short">
                    {teamRow.team.id}
                    <span
                      class:list={[
                        "status-icon",
                        {
                          "has-icon":
                            teamRow.isSurpriseTeam || teamRow.isEliminated,
                        },
                      ]}
                    >
                      {teamRow.isSurpriseTeam && (
                        <ResultEmoji name="surprise" width={20} />
                      )}
                      {teamRow.isEliminated && (
                        <ResultEmoji name="eliminated" width={20} />
                      )}
                    </span>
                  </span>
                </Link>
              </div>
            </th>
            <td class="text-right">{teamRow.teamSeason.data.overUnder}</td>
            <td class="text-right">
              {teamRow.record.w + teamRow.record.l === 0
                ? "—"
                : Utils.signedFormatter.format(teamRow.pace)}{" "}
            </td>
          </tr>
        );
      })
    }
  </Fragment>
  <Fragment slot="foot">
    <tr>
      <td class="legend-cell" colspan="3">
        <div class="legend-row">
          <ResultEmoji name="surprise" width={18} />
          <span class="legend-label">Surprise Team</span>
        </div>
        <div class="legend-row">
          <ResultEmoji name="eliminated" width={18} />
          <span class="legend-label">Eliminated</span>
        </div>
      </td>
    </tr>
  </Fragment>
</Table>

<style>
  .standings-table {
    width: 100%;
    max-width: 56rem;
  }

  @media (min-width: 768px) {
    .standings-table {
      margin-inline: auto;
    }
  }

  .title-cell {
    width: 50%;
    text-align: left !important;
  }

  @media (min-width: 1024px) {
    .title-cell {
      width: 60%;
    }
  }

  .ou-col {
    width: 33.333%;
  }

  @media (min-width: 1024px) {
    .ou-col {
      width: 25%;
    }
  }

  .pace-col {
    position: relative;
    text-align: right;
  }

  .mobile-only {
    display: inline;
  }

  .desktop-only {
    display: none;
  }

  @media (min-width: 768px) {
    .mobile-only {
      display: none;
    }

    .desktop-only {
      display: inline;
    }
  }

  .team-cell {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
  }

  .team-name-full {
    position: relative;
    display: none;
  }

  .team-name-short {
    position: relative;
    display: inline;
  }

  @media (min-width: 768px) {
    .team-name-full {
      display: inline;
    }

    .team-name-short {
      display: none;
    }
  }

  .status-icon {
    position: absolute;
  }

  .status-icon.has-icon {
    right: -2rem;
  }

  .text-right {
    text-align: right;
  }

  .legend-cell {
    padding: 1rem;

    /* was space-y-2: vertical rhythm between children, cell stays a table cell */
    > * + * {
      margin-top: 0.5rem;
    }
  }

  .legend-row {
    display: flex;
    flex-direction: row;
    gap: 1rem;
  }

  .legend-label {
    font-size: var(--text-xl);
    line-height: var(--text-xl--line-height);
    color: var(--color-lime-400);
    font-style: italic;
  }

  .popover-heading {
    margin-bottom: 0.25rem;
    font-weight: bold;
    text-decoration: underline;
  }
</style>
