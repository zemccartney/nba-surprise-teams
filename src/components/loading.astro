---
// From https://phosphoricons.com/?size=32&q=%22progress%22
import HourglassSvg from "../assets/images/hourglass-high.svg";
---

<div class="loading" slot="fallback">
  <HourglassSvg role="img" width={128} />
  <p class="loading-text">Loading ...</p>
</div>

<style>
  .loading {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: var(--color-green-200);
  }

  .loading-text {
    font-size: var(--text-2xl);
    line-height: var(--text-2xl--line-height);
    font-style: italic;
  }
</style>
