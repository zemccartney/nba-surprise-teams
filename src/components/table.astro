---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"table"> {
  // Disabling per following Astro's pattern for requiring passing children to default slot: https://docs.astro.build/en/guides/typescript/#common-prop-type-patterns
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  children: any;
  class?: string;
  compact?: boolean;
  stickyHeader?: boolean;
}

const {
  /*
    Classes available:
    - compact: tightens dimensions of table
    - stickyHeader: makes header row sticky

    TODO: Try cva here, might simplify / make API more explicit?
  */
  class: classStr,
  ...attrs
} = Astro.props;
---

<style>
  .NBASurpriseTracker-Table {
    table-layout: fixed;
    border-collapse: collapse;
    box-shadow: var(--table-shadow);

    > thead,
    > tfoot {
      background-color: var(--surface-table-head);
    }

    > thead th,
    > thead td {
      /* pr aligns right-edge of th text with td text in col (all cells right-aligned) */
      padding: 1.5rem;
      padding-right: 1rem;
      text-align: right;
      font-size: var(--text-3xl);
      line-height: var(--text-3xl--line-height);
      color: var(--ink-heading);
    }

    @media (min-width: 1024px) {
      > thead th,
      > thead td {
        font-size: var(--text-4xl);
        line-height: var(--text-4xl--line-height);
      }
    }

    > tbody th,
    > tbody td {
      padding: 2rem 1rem;
      font-size: var(--text-3xl);
      line-height: var(--text-3xl--line-height);
      color: var(--ink-primary);
    }

    @media (min-width: 1024px) {
      > tbody th,
      > tbody td {
        font-size: var(--text-4xl);
        line-height: var(--text-4xl--line-height);
      }
    }

    &.compact {
      box-shadow: var(--table-shadow-compact);

      > thead th,
      > thead td {
        /* pr aligns right-edge of th text with td text in col (all cells right-aligned) */
        padding: 0.75rem;
        padding-right: 1rem;
        font-size: var(--text-2xl);
        line-height: var(--text-2xl--line-height);
      }

      > tbody th,
      > tbody td {
        padding: 1rem;
        font-size: var(--text-2xl);
        line-height: var(--text-2xl--line-height);
        /* No color here on purpose. The unqualified `> tbody th, > tbody td`
           rule above already sets green-200, so repeating it only added
           specificity. Under Astro 7 that extra weight beat consumers'
           own cell colors (team-stats' lime-400 row labels) because the
           compiler now scopes the nested `tbody` compound too. */
      }
    }

    &.stickyHeader {
      position: relative;

      > thead th,
      > thead td {
        /* Unsure that z-index rule is right here, solved for ensuring header appeared above relatively-positioned links on standings-table */
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: var(--surface-table-head);
      }
    }
  }

  /* Separate borders travel with sticky cells, including on WebKit. Give each
     shared edge a single owner: no collapsed border + inset-shadow double line. */
  :global(:root[data-theme="light"]) .NBASurpriseTracker-Table.stickyHeader {
    border-collapse: separate;
    border-spacing: 0;
    border-left: 2px solid var(--ink-primary);

    > :is(thead, tbody, tfoot) > :global(tr) > :global(:is(th, td)) {
      border-width: 0 2px 2px 0;
    }
    > thead > :global(tr:first-child) > :global(:is(th, td)) {
      border-top-width: 2px;
    }
  }

  /* Rows arrive through the body slot and carry the caller's scope attribute,
     not Table's. Keep the table/tbody scoped, but cross that slot boundary. */
  .NBASurpriseTracker-Table > tbody > :global(tr:nth-of-type(2n + 1)) {
    background-color: var(--surface-row);
  }
</style>

<table class:list={["NBASurpriseTracker-Table", classStr]} {...attrs}>
  <thead>
    <slot name="head" />
  </thead>
  <tbody>
    <slot name="body" />
  </tbody>
  <tfoot>
    <slot name="foot" />
  </tfoot>
</table>
