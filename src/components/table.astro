---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"table"> {
  // Disabling per following Astro's pattern for requiring passing children to default slot: https://docs.astro.build/en/guides/typescript/#common-prop-type-patterns
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  children: any;
  class?: string;
  compact?: boolean;
  stickyHeader?: boolean;
}

const {
  /*
    Classes available:
    - compact: tightens dimensions of table
    - stickyHeader: makes header row sticky

    TODO: Try cva here, might simplify / make API more explicit?
  */
  class: classStr,
  ...attrs
} = Astro.props;
---

<style>
  .NBASurpriseTracker-Table {
    table-layout: fixed;
    border-collapse: collapse;
    box-shadow: var(--shadow-glow);

    > thead,
    > tfoot {
      background-color: var(--color-slate-950);
    }

    > thead th,
    > thead td {
      /* pr aligns right-edge of th text with td text in col (all cells right-aligned) */
      padding: 1.5rem;
      padding-right: 1rem;
      text-align: right;
      font-size: var(--text-3xl);
      line-height: var(--text-3xl--line-height);
      color: var(--color-lime-400);
    }

    @media (min-width: 1024px) {
      > thead th,
      > thead td {
        font-size: var(--text-4xl);
        line-height: var(--text-4xl--line-height);
      }
    }

    > tbody th,
    > tbody td {
      padding: 2rem 1rem;
      font-size: var(--text-3xl);
      line-height: var(--text-3xl--line-height);
      color: var(--color-green-200);
    }

    @media (min-width: 1024px) {
      > tbody th,
      > tbody td {
        font-size: var(--text-4xl);
        line-height: var(--text-4xl--line-height);
      }
    }

    > tbody > tr {
      &:nth-of-type(2n + 1) {
        background-color: var(--color-lime-950);
      }
    }

    &.compact {
      box-shadow: var(--shadow-glow-sm);

      > thead th,
      > thead td {
        /* pr aligns right-edge of th text with td text in col (all cells right-aligned) */
        padding: 0.75rem;
        padding-right: 1rem;
        font-size: var(--text-2xl);
        line-height: var(--text-2xl--line-height);
      }

      > tbody th,
      > tbody td {
        padding: 1rem;
        font-size: var(--text-2xl);
        line-height: var(--text-2xl--line-height);
        color: var(--color-green-200);
      }
    }

    &.stickyHeader {
      position: relative;

      > thead th,
      > thead td {
        /* Unsure that z-index rule is right here, solved for ensuring header appeared above relatively-positioned links on standings-table */
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: var(--color-slate-950);
      }
    }
  }
</style>

<table class:list={["NBASurpriseTracker-Table", classStr]} {...attrs}>
  <thead>
    <slot name="head" />
  </thead>
  <tbody>
    <slot name="body" />
  </tbody>
  <tfoot>
    <slot name="foot" />
  </tfoot>
</table>
