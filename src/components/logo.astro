---
import type { HTMLAttributes } from "astro/types";
import type { CollectionEntry } from "astro:content";

import * as ContentUtils from "../content-utils";

type Props = Pick<HTMLAttributes<"img">, "loading"> & {
  class?: string;
  height?: number;
  seasonId: CollectionEntry<"seasons">["id"];
  team: CollectionEntry<"teams">;
  width?: number;
};

const {
  class: className,
  height = 36,
  loading = "lazy",
  seasonId,
  team,
  width = 36,
  ...props
} = Astro.props;

const alt = `Logo for ${team.data.name}`;

/*
  Plain <img>, not Astro's <Image>, because every logo is an SVG. The image
  service cannot resize an SVG: Astro's sharp service returns the input buffer
  unchanged for svg output, and Cloudflare Images documents that it ignores
  optimization parameters for SVG. So <Image> bought nothing and cost two
  things — a byte-identical extra file in the build per requested size, and,
  since this renders inside a server island, a runtime /_image request per
  logo. `.src` is the plain hashed asset URL, cached once per logo.
*/
const { default: logo } = await ContentUtils.getTeamSeasonLogo(team, seasonId);
---

<img
  alt={alt}
  class={className}
  decoding="async"
  height={height}
  loading={loading}
  src={logo.src}
  width={width}
  {...team.data.id === ContentUtils.TEAM_CODES.DET && {
    // tweak to slightly improve contrast
    style:
      "filter: drop-shadow(-1rem -1rem 1rem #016270) drop-shadow(1rem 1rem 1rem #016271);",
  }}
  {...props}
/>
