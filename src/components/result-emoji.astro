---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

import Skull from "../assets/images/emoji/skull-and-crossbones.svg";

type Props = Omit<HTMLAttributes<"img">, "src"> & {
  name: "celebration" | "disappointed" | "eliminated" | "surprise";
};

const {
  class: className,
  height,
  loading = "lazy",
  name,
  width,
  ...attrs
} = Astro.props;

/*
Note the below crashes if exported (fixable by writing type out on a separate line)

export const emojiConf: Record<
  Props["name"],
  { fileName: string; alt: string }
>
(ended up not needing to export anyway)

resulted in a crash with the following message: Expected ">" but found "$$ResultEmoji"

TODO Report issue
*/

const emojiConf: Record<Props["name"], { alt: string; fileName: string }> = {
  celebration: {
    alt: "Party popper emoji, celebrating a team achieving surprise team status",
    fileName: "party-popper",
  },
  disappointed: {
    alt: "Sad-but-relieved-face emoji, bemoaning a team failing to achieve surprise team status",
    fileName: "sad-but-relieved-face",
  },
  eliminated: {
    alt: "Skull and crossbones emoji, indicating a team is eliminated from surprise team contention",
    fileName: "skull-and-crossbones",
  },
  surprise: {
    alt: "Hushed face emoji, indicating team is a surprise team",
    fileName: "hushed-face",
  },
};

/*
  Most emoji stay plain <img>; see logo.astro for why. The skull is inline so
  its eyes can be styled independently. Callers pass only a width; complete
  height from the same source metadata in either case to avoid layout shift.
*/
const emoji = (
  (await import(`../assets/images/emoji/${emojiConf[name].fileName}.svg`)) as {
    default: ImageMetadata;
  }
).default;

const resolvedWidth = Number(width ?? emoji.width);
const resolvedHeight = Number(
  height ?? Math.round(resolvedWidth * (emoji.height / emoji.width)),
);
---

{
  name === "eliminated" ? (
    <Skull
      aria-label={emojiConf[name].alt}
      class:list={["result-emoji-skull", className]}
      data-result-emoji={name}
      focusable="false"
      height={resolvedHeight}
      role="img"
      width={resolvedWidth}
      {...attrs}
    />
  ) : (
    <img
      alt={emojiConf[name].alt}
      class={className}
      data-result-emoji={name}
      decoding="async"
      height={resolvedHeight}
      loading={loading}
      src={emoji.src}
      width={resolvedWidth}
      {...attrs}
    />
  )
}

<style>
  /* Inline only the skull so CSS can paint/glow its eyes independently.
     Explicit image semantics retain the original accessible description. */
  .result-emoji-skull {
    max-width: 100%;
    height: auto;
  }
  .result-emoji-skull :global(.skull-head) {
    fill: var(--skull-head);
  }
  .result-emoji-skull :global(.skull-bones) {
    fill: var(--skull-bones);
  }
  .result-emoji-skull :global(.skull-nose) {
    fill: var(--skull-nose);
  }
  .result-emoji-skull :global(.skull-eye) {
    fill: var(--skull-eyes);
    filter: var(--skull-eye-glow);
  }
</style>
