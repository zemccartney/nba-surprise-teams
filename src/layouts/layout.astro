---
import "@fontsource/iosevka-curly/400.css";
import "@fontsource/iosevka-curly/700.css";
import "@fontsource-variable/sixtyfour/full.css";

import "../styles/global.css";

interface Props {
  description?: string;
  title?: string;
}

const { description, title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />

    <title>{title ? `${title} - NBASTT` : "NBA Surprise Teams Tracker"}</title>
    <meta
      content={description ||
        "Tracking if NBA teams exceed their low preseason expectations"}
      name="description"
    />
  </head>
  <body>
    <div class="page-bg">
      <div class="container">
        <header class="header">
          <slot name="header" />
        </header>
        <slot />
      </div>
    </div>
  </body>
</html>

<style>
  .page-bg {
    background-color: var(--color-dark-emerald);
    min-height: 100%;
  }

  .container {
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .container {
      max-width: 768px;
    }
  }

  @media (min-width: 1024px) {
    .container {
      max-width: 1024px;
    }
  }

  @media (min-width: 1280px) {
    .container {
      max-width: 1280px;
    }
  }

  @media (min-width: 1536px) {
    .container {
      max-width: 1536px;
    }
  }

  .header {
    padding: 2rem;
  }
</style>
