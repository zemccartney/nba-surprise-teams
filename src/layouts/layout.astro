---
import "@fontsource/iosevka-curly/400.css";
import "@fontsource/iosevka-curly/700.css";
import "@fontsource-variable/sixtyfour/full.css";
import sixtyfourLatinUrl from "@fontsource-variable/sixtyfour/files/sixtyfour-latin-full-normal.woff2?url";

import "../styles/global.css";

interface Props {
  description?: string;
  title?: string;
}

const { description, title } = Astro.props;
const pageTitle = title ? `${title} - NBASTT` : "NBA Surprise Teams Tracker";
const pageDescription =
  description ||
  "Tracking if NBA teams exceed their low preseason expectations";
const pageUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://nbastt.grepco.net",
).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Resolve before first paint. Preserve the original branch's storage key.
      let theme;
      try {
        theme = localStorage.getItem("theme");
      } catch {
        // Fall back to the system preference when storage is unavailable.
      }
      document.documentElement.dataset.theme =
        theme === "light" || theme === "dark"
          ? theme
          : matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
    </script>
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <link
      as="font"
      crossorigin="anonymous"
      href={sixtyfourLatinUrl}
      rel="preload"
      type="font/woff2"
    />
    <link
      as="font"
      crossorigin="anonymous"
      href="/fonts/ChicagoKare-Regular.woff2"
      rel="preload"
      type="font/woff2"
    />

    <title>{pageTitle}</title>
    <meta content={pageDescription} name="description" />
    <meta content={pageTitle} property="og:title" />
    <meta content={pageDescription} property="og:description" />
    <meta content="website" property="og:type" />
    <meta content={pageUrl} property="og:url" />
    <meta content="https://nbastt.grepco.net/og.png" property="og:image" />
    <meta content="1200" property="og:image:width" />
    <meta content="630" property="og:image:height" />
    <meta content="image/png" property="og:image:type" />
    <meta content="NBA Surprise Teams Tracker" property="og:image:alt" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content="https://nbastt.grepco.net/og.png" name="twitter:image" />
    <meta content="NBA Surprise Teams Tracker" name="twitter:image:alt" />
  </head>
  <body>
    <div class="page-bg">
      <div class="container">
        <header class="header">
          <slot name="header" />
        </header>
        <slot />
      </div>
    </div>
  </body>
</html>

<style>
  .page-bg {
    background-color: var(--surface-page);
    min-height: 100%;
  }

  .container {
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .container {
      max-width: 768px;
    }
  }

  @media (min-width: 1024px) {
    .container {
      max-width: 1024px;
    }
  }

  @media (min-width: 1280px) {
    .container {
      max-width: 1280px;
    }
  }

  @media (min-width: 1536px) {
    .container {
      max-width: 1536px;
    }
  }

  .header {
    padding: 2rem 1rem;
  }

  @media (min-width: 640px) {
    .header {
      padding-inline: 2rem;
    }
  }
</style>
