---
import type { HTMLTag } from "astro/types";
import type { ClassValue } from "clsx";

interface Props {
  class?: ClassValue;
  element?: HTMLTag;
}

// Rest props carry the parent's scoped-style attribute (data-astro-cid-*) when a
// parent passes `class`; without spreading them, parent-scoped classes never match.
const { class: classVal, element = "div", ...rest } = Astro.props;

const Element = element;
---

<style>
  .TypoBox {
    /* General rules, apply to all instances of elements, wherever they appear in tree */
    ul {
      list-style-type: disc;
      list-style-position: inside;
      padding-inline-start: 1em;
    }

    ol {
      list-style-type: decimal;
      list-style-position: inside;
      padding-inline-start: 1em;
    }

    @media (min-width: 768px) {
      ul,
      ol {
        padding-inline-start: 2em;
      }
    }

    ol,
    ul {
      li {
        margin-top: 0.5em;
      }
    }

    /*
        Layout rules, assume only relevant to top level of layout, that container elements
        will more often than not want to be responsible for spacing/laying out their own children
      */
    & > * {
      & + * {
        margin-top: 1em;
      }

      & + h1,
      & + h2,
      & + h3 {
        margin-top: 1.5em;
        margin-bottom: 1em;
      }

      & + ul,
      & + ol {
        margin-top: 0.5em;
      }
    }
  }
</style>

<Element class:list={["TypoBox", classVal]} {...rest}>
  <slot />
</Element>
