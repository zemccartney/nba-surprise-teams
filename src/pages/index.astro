---
import Link from "../components/link.astro";
import StandingsTable from "../components/standings-table/index.astro";
import * as ContentUtils from "../content-utils";
import Layout from "../layouts/layout.astro";
import Typography from "../layouts/typography.astro";

const latestSeason = await ContentUtils.getLatestSeason();

if (!latestSeason) {
  throw new Error("Insufficient season data");
}

const teamsInSeason = await ContentUtils.getTeamsInSeason(latestSeason.id);
const isSeasonReady = teamsInSeason.length > 0;

const [, mm, dd] = latestSeason.data.startDate.split("-");
---

<Layout>
  <Fragment slot="header">
    <h1 class="home-title">NBA Surprise Teams Tracker</h1>
    <nav class="home-nav">
      <Link class="home-nav-link" href="/archive">Archive</Link>
      <Link class="home-nav-link" href="/stats">Stats</Link>
      <Link class="home-nav-link" href="/about">About</Link>
    </nav>
  </Fragment>
  <main class="home-main">
    {isSeasonReady && <StandingsTable seasonId={latestSeason.id} />}
    {
      !isSeasonReady && (
        <Typography class="content-narrow">
          <h2 class="section-title">
            Countdown to the{" "}
            <span class="nowrap">
              {ContentUtils.abbreviateSeasonRange(latestSeason, {
                compact: true,
              })}
            </span>{" "}
            season
          </h2>
          <p class="body-text">
            Next season kicks off on {`${mm}/${dd}`}! Pre-season over/unders are
            typically posted mid-September. Till then, check out how{" "}
            <Link href="/archive">past years</Link> shook out.
          </p>
        </Typography>
      )
    }
  </main>
</Layout>

<style>
  .home-title {
    font-family: var(--font-title);
    text-align: center;
    font-size: var(--text-3xl);
    line-height: var(--text-3xl--line-height);
    text-wrap: balance;
    color: var(--color-lime-400);
  }

  @media (min-width: 768px) {
    .home-title {
      font-size: var(--text-5xl);
      line-height: var(--text-5xl--line-height);
    }
  }

  @media (min-width: 1024px) {
    .home-title {
      font-size: var(--text-7xl);
      line-height: var(--text-7xl--line-height);
    }
  }

  .home-nav {
    margin-top: 2rem;
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .home-nav {
      margin-top: 4rem;
      gap: 3rem;
    }
  }

  .home-nav-link {
    font-size: var(--text-2xl);
    line-height: var(--text-2xl--line-height);
  }

  @media (min-width: 768px) {
    .home-nav-link {
      font-size: var(--text-3xl);
      line-height: var(--text-3xl--line-height);
    }
  }

  @media (min-width: 1024px) {
    .home-nav-link {
      font-size: var(--text-4xl);
      line-height: var(--text-4xl--line-height);
    }
  }

  .home-main {
    margin-top: 1rem;
    padding-bottom: 6rem;
  }

  @media (min-width: 640px) {
    .home-main {
      margin-top: 4rem;
    }
  }

  @media (min-width: 768px) {
    .home-main {
      padding-inline: 2rem;
    }
  }

  .content-narrow {
    margin-inline: auto;
    padding-inline: 1rem;
  }

  @media (min-width: 1024px) {
    .content-narrow {
      max-width: 60%;
    }
  }

  .section-title {
    font-family: var(--font-title);
    text-align: center;
    font-size: var(--text-2xl);
    line-height: var(--text-2xl--line-height);
    text-wrap: balance;
    color: var(--color-lime-400);
  }

  @media (min-width: 768px) {
    .section-title {
      font-size: var(--text-4xl);
      line-height: var(--text-4xl--line-height);
    }
  }

  .body-text {
    font-size: var(--text-2xl);
    line-height: var(--text-2xl--line-height);
    color: var(--color-green-200);
  }

  .nowrap {
    white-space: nowrap;
  }
</style>
