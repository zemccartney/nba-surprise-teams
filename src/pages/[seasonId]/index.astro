---
import { getCollection } from "astro:content";

import ArrowLeftSvg from "../../assets/images/arrow-line-left.svg";
import ArrowRightSvg from "../../assets/images/arrow-line-right.svg";
import Link from "../../components/link.astro";
import Popover from "../../components/popover.astro";
import StandingsTable from "../../components/standings-table/index.astro";
import * as ContentUtils from "../../content-utils.ts";
import Subpage from "../../layouts/subpage.astro";
import * as Utils from "../../utils";

export const getStaticPaths = async () => {
  const seasons = await getCollection("seasons");
  const seasonsWithTeams = [];

  for (const season of seasons) {
    const teams = await ContentUtils.getTeamsInSeason(season.id);
    if (teams.length > 0) {
      seasonsWithTeams.push({
        params: { seasonId: season.id },
        props: { season },
      });
    }
  }

  return seasonsWithTeams;
};

const { season } = Astro.props;

const archivedSeasons = await ContentUtils.getArchivedSeasons();
archivedSeasons.reverse();

const adjacent = (x: -1 | 1) => {
  const si = archivedSeasons.findIndex((s) => s.id === season.id) + x;

  if (si === -1) {
    return false;
  }

  return archivedSeasons.at(si);
};

const hasArchive = await ContentUtils.getSeasonArchive(season.id);
const surpriseRules = await ContentUtils.getSeasonSurpriseRules(season.id);
const fmtSeason = ContentUtils.abbreviateSeasonRange(season, { compact: true });

const seasonBefore = adjacent(-1);
const seasonAfter = adjacent(1);
---

<script>
  const mediaQueryList = globalThis.matchMedia(
    "not all and (min-width: 640px)",
  );

  function handleOrientationChange(ev: MediaQueryList | MediaQueryListEvent) {
    const seasonButtons = document.querySelectorAll(".SeasonArchiveButton");
    if (ev.matches && seasonButtons?.length > 0) {
      for (const button of seasonButtons) button.setAttribute("width", "24");
    } else {
      for (const button of seasonButtons) button.setAttribute("width", "32");
    }
  }

  handleOrientationChange(mediaQueryList);
  mediaQueryList.addEventListener("change", handleOrientationChange);
</script>

<Subpage
  description={`Results for the ${fmtSeason} season`}
  title={`${fmtSeason} Season`}
>
  <div class="season-content">
    {
      hasArchive && (
        <div class="season-nav">
          {seasonBefore && (
            <a class="season-button" href={`/${seasonBefore.id}`}>
              <ArrowLeftSvg
                class="SeasonArchiveButton fill-current"
                width={24}
              />
              <span>
                {ContentUtils.abbreviateSeasonRange(seasonBefore, {
                  compact: true,
                })}{" "}
                Season
              </span>
            </a>
          )}
          {seasonAfter && (
            <a class="season-button" href={`/${seasonAfter.id}`}>
              {ContentUtils.abbreviateSeasonRange(seasonAfter, {
                compact: true,
              })}{" "}
              Season
              <ArrowRightSvg
                class="SeasonArchiveButton fill-current"
                width={24}
              />
            </a>
          )}
        </div>
      )
    }
    <h1
      class:list={[
        "season-title",
        season.data.episodeUrl || season.data.shortened
          ? "spacing-sm"
          : "spacing-lg",
      ]}
    >
      {`${fmtSeason} Season`}
    </h1>
    {
      season.data.episodeUrl && (
        <div class="episode-link-wrapper">
          <Link
            class="episode-link"
            href={season.data.episodeUrl}
            target="_blank"
          >
            <span class="italic">Slam N' Jam</span> Episode
          </Link>
          <Popover
            classes={{
              body: "popover-episode-body",
              trigger: "popover-episode-trigger",
            }}
            id="episode-popover"
          >
            If the link's broken (grumbling about Apple...), you're looking for
            the episode "{season.data.episodeTitle}" from
            {/* eslint-disable-next-line @typescript-eslint/no-non-null-assertion */}
            {season.data.episodeDate!.split("-").slice(1).join("/")}/{""}
            {/* eslint-disable-next-line @typescript-eslint/no-non-null-assertion */}
            {season.data.episodeDate!.split("-")[0]}
          </Popover>
        </div>
      )
    }
    {
      season.data.shortened && (
        <section class="shortened-section">
          <h2 class="shortened-title">
            Shortened season: {season.data.shortened.numGames} games played
          </h2>
          <h3 class="shortened-reason">{season.data.shortened.reason}</h3>
          <h3 class="shortened-adjustments">Adjustments</h3>
          <ul class="shortened-list">
            {/* Consistent widths to align bullets while centering */}
            <li>
              Over/Under Cutoff:{" "}
              <span class="highlight">
                {surpriseRules.overUnderCutoff.toPrecision(3)}
              </span>
            </li>
            <li>
              Surprise Team Pace Cutoff:{" "}
              <span class="highlight">
                {Utils.signedFormatter.format(surpriseRules.paceTarget)}
              </span>
            </li>
          </ul>
        </section>
      )
    }
    <StandingsTable seasonId={season.id} title={false} />
  </div>
</Subpage>

<style>
  .season-content {
    padding-inline: 0;
  }

  @media (min-width: 768px) {
    .season-content {
      padding-inline: 2rem;
    }
  }

  .season-nav {
    margin-bottom: 3rem;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 3rem;
  }

  @media (min-width: 768px) {
    .season-nav {
      margin-top: -3rem;
    }
  }

  .season-button {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    border: 2px solid var(--color-indigo-500);
    background-color: var(--color-slate-950);
    padding: 0.5rem 1rem;
    font-size: var(--text-base);
    line-height: var(--text-base--line-height);
    color: var(--color-lime-500);
    text-decoration: none;
  }

  .season-button:hover {
    border-color: var(--color-slate-950);
    background-color: var(--color-lime-500);
    color: var(--color-slate-950);
  }

  @media (min-width: 768px) {
    .season-button {
      font-size: var(--text-xl);
      line-height: var(--text-xl--line-height);
    }
  }

  .fill-current {
    fill: currentColor;
  }

  .season-title {
    font-family: var(--font-title);
    text-align: center;
    font-size: var(--text-2xl);
    line-height: var(--text-2xl--line-height);
    color: var(--color-lime-400);
  }

  @media (min-width: 768px) {
    .season-title {
      font-size: var(--text-4xl);
      line-height: var(--text-4xl--line-height);
    }
  }

  .spacing-sm {
    margin-bottom: 1.5rem;
  }

  @media (min-width: 640px) {
    .spacing-sm {
      margin-bottom: 3rem;
    }
  }

  .spacing-lg {
    margin-bottom: 3rem;
  }

  @media (min-width: 640px) {
    .spacing-lg {
      margin-bottom: 6rem;
    }
  }

  .episode-link-wrapper {
    position: relative;
    margin-inline: auto;
    margin-bottom: 3rem;
    width: fit-content;
  }

  @media (min-width: 640px) {
    .episode-link-wrapper {
      margin-bottom: 6rem;
    }
  }

  .episode-link {
    position: relative;
    display: inline-block;
    width: fit-content;
    font-size: var(--text-xl);
    line-height: var(--text-xl--line-height);
  }

  @media (min-width: 768px) {
    .episode-link {
      font-size: var(--text-2xl);
      line-height: var(--text-2xl--line-height);
    }
  }

  @media (min-width: 1024px) {
    .episode-link {
      font-size: var(--text-4xl);
      line-height: var(--text-4xl--line-height);
    }
  }

  .italic {
    font-style: italic;
  }

  .shortened-section {
    margin-bottom: 3rem;
    padding-inline: 1rem;
    font-size: var(--text-xl);
    line-height: var(--text-xl--line-height);
    color: var(--color-yellow-200);
  }

  @media (min-width: 640px) {
    .shortened-section {
      margin-bottom: 6rem;
    }
  }

  .shortened-title {
    text-align: center;
    font-size: var(--text-2xl);
    line-height: var(--text-2xl--line-height);
    text-wrap: balance;
    color: var(--color-yellow-400);
  }

  .shortened-reason {
    margin-inline: auto;
    width: fit-content;
    text-align: center;
    text-wrap: balance;
  }

  .shortened-adjustments {
    margin-top: 1rem;
    text-align: center;
    text-decoration: underline;
  }

  .shortened-list {
    margin-inline: auto;
    width: fit-content;
    list-style-type: disc;
    list-style-position: inside;
  }

  .highlight {
    color: var(--color-yellow-400);
  }
</style>
