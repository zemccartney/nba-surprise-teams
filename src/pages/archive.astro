---
import Link from "../components/link.astro";
import * as ContentUtils from "../content-utils";
import Subpage from "../layouts/subpage.astro";
import Typography from "../layouts/typography.astro";

const archivedSeasons = await ContentUtils.getArchivedSeasons();
---

<Subpage
  description="Listing of seasons tracked for surprise teams so far"
  title="Archive"
>
  <Typography class="content-narrow">
    <h1 class="page-title">Archive</h1>
    <div class="archive-list">
      {
        archivedSeasons.map((season) => (
          <Link class="archive-link" href={`/${season.id}/`}>
            {ContentUtils.abbreviateSeasonRange(season)}
          </Link>
        ))
      }
    </div>
  </Typography>
</Subpage>

<style>
  .content-narrow {
    margin-inline: auto;
    padding-inline: 1rem;
  }

  @media (min-width: 1024px) {
    .content-narrow {
      max-width: 60%;
    }
  }

  .page-title {
    font-family: var(--font-title);
    text-align: center;
    font-size: var(--text-2xl);
    line-height: var(--text-2xl--line-height);
    color: var(--color-lime-400);
  }

  @media (min-width: 768px) {
    .page-title {
      font-size: var(--text-4xl);
      line-height: var(--text-4xl--line-height);
    }
  }

  .archive-list {
    margin-top: 1.5rem !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .archive-list {
      margin-top: 3rem !important;
      gap: 3rem;
    }
  }

  .archive-link {
    font-size: var(--text-4xl);
    line-height: var(--text-4xl--line-height);
  }
</style>
