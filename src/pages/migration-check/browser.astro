---
import { env } from "cloudflare:workers";

import {
  isProbeAuthorized,
  probeAuth,
} from "../../diagnostics/migration-probe";
import Layout from "../../layouts/layout.astro";

// eslint-disable-next-line unicorn/consistent-boolean-name -- Astro route API.
export const prerender = false;
if (
  !(await isProbeAuthorized(
    Astro.request,
    Reflect.get(env, "PUBLIC_DEPLOY_ENV"),
    probeAuth,
  ))
)
  return new Response(undefined, { status: 404 });
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");
---

<Layout title="Temporary migration diagnostic">
  <button id="migration-smoke" type="button"
    >Send labelled Sentry smoke event</button
  >
  <pre id="migration-result"></pre>
</Layout>

<script>
  import * as Sentry from "@sentry/astro";

  document
    .querySelector("#migration-smoke")
    ?.addEventListener("click", async () => {
      const marker =
        "NBASTT cf migration browser smoke " + new Date().toISOString();
      const eventId = Sentry.captureException(new Error(marker));
      const flushed = await Sentry.flush(5000);
      const client = Sentry.getClient();
      const result = document.querySelector("#migration-result");
      if (result)
        result.textContent = JSON.stringify({
          enabled: Boolean(client?.getDsn()),
          environment: client?.getOptions().environment,
          eventId,
          flushed,
          marker,
          release: client?.getOptions().release,
        });
    });
</script>
