---
// eslint-disable-next-line import-x/no-unresolved -- Provided by the pilot's environment-aware Vite plugin.
import { backend, catalog } from "virtual:tracker/catalog";

import type { Game } from "../catalog";

import Chart from "../../../src/components/charts/team-season-pace.astro";
import { paceView } from "../catalog";
interface Props {
  games: Game[];
  seasonId: string;
  teamId: string;
}
const start = performance.now();
const { games, seasonId, teamId } = Astro.props;
const view = paceView(catalog, seasonId, teamId, games);
const latest = catalog.getLatestSeason();
const latestCharlotte = catalog.getTeamSeason(latest.id, "CHA");
const elapsed = performance.now() - start;
console.log(
  "[sqlite-pilot] " +
    JSON.stringify({
      backend,
      calculationMs: elapsed,
      games: view.chart.data.length,
      seasonId,
      teamId,
    }),
);
---

<section
  data-backend={backend}
  data-latest-odds={latestCharlotte?.overUnder ?? "missing"}
  data-sqlite-pilot
>
  <h2>{view.name}: {seasonId}</h2>
  <p>
    Data backend: <strong>{backend}</strong>. Archived fixture, not live NBA/KV
    data.
  </p>
  <p>
    Record: {view.record.w}–{view.record.l}. Odds: {view.overUnder}. Wins to
    surprise: {view.chart.winsToSurprise}.
  </p>
  <p>
    Metadata refresh check: latest season {latest.id}, Charlotte odds {
      latestCharlotte?.overUnder ?? "not entered"
    }.
  </p>
  <Chart {...view.chart} />
</section>
