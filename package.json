{
  "name": "surprise-teams",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "archive:all": "node data/cli.ts archive-nba --all",
    "archive:diff": "git diff -- data/dump.sql",
    "archive:latest": "node data/cli.ts archive-nba --latest",
    "astro": "astro",
    "audit": "pnpm audit",
    "build": "wrangler types && pnpm run verify && astro build && node data/node/audit.ts",
    "cf:wip": "git commit -m \"[CF-Pages-Skip] WIP\" && git push",
    "check": "astro check && pnpm run fmt:check && pnpm run lint && pnpm run lint:workflows",
    "deps": "ncu -i --cooldown 3 -p pnpm",
    "fmt": "prettier . --write",
    "fmt:check": "prettier . --check",
    "info": "astro info",
    "postinstall": "pnpm run audit",
    "kv:destroy": "rm -rf .wrangler/state",
    "kv:reset": "wrangler kv key delete $(node data/cli.ts latest-season) --binding=GAMES_KV --local",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "lint:debug": "eslint --flag unstable_native_nodejs_ts_config --inspect-config",
    "lint:workflows": "zizmor --offline --strict-collection .github/workflows",
    "preview": "wrangler types && astro preview",
    "start": "rm -r .wrangler || true && wrangler types && astro sync && concurrently --raw --kill-others --kill-timeout 5000 \"astro dev\" \"astro check --watch --preserveWatchOutput --noSync\"",
    "test": "vitest --run",
    "typewatch": "astro check --watch --preserveWatchOutput",
    "verify": "pnpm run audit && pnpm run check && pnpm test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.0",
    "@fontsource-variable/sixtyfour": "^5.3.0",
    "@fontsource/iosevka-curly": "^5.3.0",
    "@sentry/astro": "10.27.0",
    "@sentry/cloudflare": "10.27.0",
    "@tanstack/charts": "0.18.0",
    "astro": "^7.3.1",
    "d3-shape": "3.2.0",
    "echarts": "6.1.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/d3-shape": "3.1.8",
    "@types/node": "^26.4.1",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-package-json": "^1.8.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "npm-check-updates": "^23.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "svgo": "^4.1.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "26"
  }
}
