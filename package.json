{
  "name": "surprise-teams",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "archive:all": "node data/cli.ts archive-nba --all",
    "archive:diff": "git diff -- data/dump.sql",
    "archive:latest": "node data/cli.ts archive-nba --latest",
    "astro": "astro",
    "audit": "pnpm audit --prod --audit-level=critical",
    "build": "cf workers types && pnpm run verify && astro build --timings && node data/node/audit.ts",
    "cf:wip": "git commit -m \"[CF-Pages-Skip] WIP\" && git push",
    "check": "astro check && pnpm run fmt:check && pnpm run lint && pnpm run lint:workflows",
    "deps": "ncu -i --cooldown 3 -p pnpm",
    "fmt": "prettier . --write",
    "fmt:check": "prettier . --check",
    "info": "astro info",
    "kv:destroy": "rm -rf .cloudflare/state",
    "kv:reset": "cf kv keys delete $(node data/cli.ts latest-season) --namespace-id 6061594acc5c4fb6b3846b0c78f9e5a3 --local --persist-to .cloudflare/state",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "lint:debug": "eslint --flag unstable_native_nodejs_ts_config --inspect-config",
    "lint:workflows": "zizmor --offline --strict-collection .github/workflows",
    "og:generate": "node scripts/og.mjs",
    "og:preview": "node scripts/og.mjs --preview",
    "preview": "cf workers types && astro preview",
    "start": "rm -rf .cloudflare/state && cf workers types && astro sync && concurrently --raw --kill-others --kill-timeout 5000 \"astro dev\" \"astro check --watch --preserveWatchOutput --noSync\"",
    "test": "vitest --run",
    "test:dev-islands": "node scripts/check-dev-islands.ts",
    "typewatch": "astro check --watch --preserveWatchOutput",
    "verify": "pnpm run audit && pnpm run check && pnpm test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "15.0.0-beta.1",
    "@fontsource-variable/sixtyfour": "^5.3.0",
    "@sentry/astro": "10.27.0",
    "@sentry/cloudflare": "10.27.0",
    "@tanstack/charts": "0.18.0",
    "astro": "7.4.0",
    "d3-shape": "3.2.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/d3-shape": "3.2.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "cf": "1.0.0-beta.18",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-package-json": "^1.10.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.13.0",
    "npm-check-updates": "^23.1.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "svgo": "^4.1.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "26"
  }
}
