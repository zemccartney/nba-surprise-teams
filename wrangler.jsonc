{
  // Adapter 14 makes this the build and deploy config, not just a local-dev
  // convenience: `astro build` reads it and `wrangler deploy` ships what it
  // describes. Keys the adapter fills in when absent (assets.directory, the
  // SESSION KV namespace) are left out; `session: false` in astro.config.mjs is
  // what keeps SESSION from being provisioned. Keys are sorted because
  // json/sort-keys lints this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "binding": "ASSETS"
  },
  // Node compatibility is implicit from 2026-08-04. Keep the date within the
  // installed workerd runtime's supported range (currently through 2026-09-10).
  "compatibility_date": "2026-09-10",
  // TODO Fill in the real namespace id from the Cloudflare dashboard before the
  // first Workers deploy. Local dev ignores it and uses .wrangler/state.
  "kv_namespaces": [{ "binding": "GAMES_KV", "id": "REPLACE_WITH_REAL_KV_ID" }],
  "main": "./sentry.server.config.ts",
  "name": "nba-surprise-teams",
  "observability": {
    "enabled": true
  },
  "preview_urls": true,
  // Native branch Previews use test resources, never the production binding above.
  // Branches share this preview namespace; KV is not automatically cloned per branch.
  "previews": {
    "kv_namespaces": [
      { "binding": "GAMES_KV", "id": "6a0d30705c634691873dd1dd122969e3" }
    ],
    "vars": {
      "PUBLIC_DEPLOY_ENV": "preview"
    }
  },
  // Keep the existing parent's production URL disabled until production approval.
  "workers_dev": false
}
